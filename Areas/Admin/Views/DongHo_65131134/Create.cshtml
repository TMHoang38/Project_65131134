@section scripts {
    <script>// Hàm định dạng số về chuỗi VND (ví dụ: 100000 -> 100.000 VND)
        function formatVND(n) {
            return n.toFixed(0).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + ' VND';
        }

        // Hàm chuyển chuỗi về số (để gửi lên server)
        function unformatVND(s) {
            return s.replace(/[^0-9]/g, ''); // Xóa tất cả ký tự không phải số
        }

        $(document).ready(function () {
            var $input = $('#GiaBanInput');

            // Định dạng giá trị ban đầu nếu có
            if ($input.val() && $input.val() !== '0,00') {
                $input.val(formatVND(parseFloat($input.val().replace(',', '.')))); // Chuyển sang số và định dạng
            }

            $input.on('blur', function() {
                var value = unformatVND($(this).val());
                if (value) {
                    $(this).val(formatVND(parseFloat(value)));
                }
            }).on('focus', function() {
                // Khi focus vào, hiển thị giá trị số để người dùng dễ chỉnh sửa và tránh lỗi validation
                var value = unformatVND($(this).val());
                $(this).val(value);
            });

            // Xử lý khi form submit, đảm bảo gửi giá trị số lên server
            $('form').submit(function() {
                var value = unformatVND($input.val());
                $input.val(value); // Đặt lại giá trị số trước khi submit
            });
        });</script>
