@model IEnumerable<Project_65131134.Models.DongHo>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var grid = new WebGrid(Model, canPage: true, defaultSort: "MaKhachHang", rowsPerPage: 5);
}

<style>

    .grid-footer {
        text-align: center;
        padding: 15px 0;
    }


        .grid-footer a {
            color: #007bff;
            text-decoration: none;
            padding: 8px 12px;
            margin: 0 4px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            display: inline-block;
            transition: background-color 0.3s, color 0.3s;
        }


            .grid-footer a[disabled],
            .grid-footer b,
            .grid-footer a.webgrid-pager-current {
                background-color: #007bff;
                color: white;
                border-color: #007bff;
                font-weight: bold;
                cursor: default;
            }


            .grid-footer a:not(.webgrid-pager-current):hover {
                background-color: #e9ecef;
                color: #0056b3;
            }
    .webgrid-header th {
        white-space: nowrap;
        text-align: center;
        vertical-align: middle;
    }
    .image-container-admin {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5px;
    }

    /* Định dạng ảnh: Hiển thị toàn bộ khung hình, không bị méo */
    .img-watch-admin {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain; /* Quan trọng: Giúp hiện hết toàn bộ đồng hồ */
        transition: transform 0.2s;
    }

        .img-watch-admin:hover {
            transform: scale(1.2); /* Hiệu ứng phóng lớn nhẹ khi di chuột vào */
        }

    .no-image-placeholder {
        font-size: 10px;
        color: #999;
        text-transform: uppercase;
    }

</style>


<h2 class="text-center my-4 text-primary fw-bold">Danh sách đồng hồ</h2>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    @Html.ActionLink("Thêm đồng hồ mới", "Create", null, new { @class = "btn btn-success text-white" })

    <a href="@Url.Action("Index")" class="btn btn-outline-secondary text-nowrap">Tất cả sản phẩm</a>

    <form class="d-flex flex-wrap align-items-center gap-2 flex-grow-1" method="get" action="@Url.Action("Index")">

        <input type="text"
               name="searchTerm"
               value="@ViewBag.SearchTerm"
               class="form-control bg-light"
               style="flex-grow: 1; min-width: 200px;"
               placeholder="Nhập tên sản phẩm cần tìm" />

        @Html.DropDownList("brandId",
                            (SelectList)ViewBag.BrandList,
                            "Chọn thương hiệu",
                            new { @class = "form-select bg-light", @style = "width: auto; min-width: 150px;" })

        <select name="priceRange" class="form-select bg-light" style="width: auto; min-width: 180px;">
            <option value="">Chọn khoảng giá</option>
            <option value="lt1" @(ViewBag.PriceRange == "lt1" ? "selected" : "")>Dưới 1 triệu</option>
            <option value="1to3" @(ViewBag.PriceRange == "1to3" ? "selected" : "")>1 - 3 triệu</option>
            <option value="3to5" @(ViewBag.PriceRange == "3to5" ? "selected" : "")>3 - 5 triệu</option>
            <option value="5to10" @(ViewBag.PriceRange == "5to10" ? "selected" : "")>5 - 10 triệu</option>
            <option value="gt10" @(ViewBag.PriceRange == "gt10" ? "selected" : "")>Trên 10 triệu</option>
        </select>

        <button class="btn btn-primary text-nowrap" type="submit">
            <i class="fas fa-search me-1"></i> Lọc
        </button>
    </form>
</div>

<div id="gridContent" class="table-responsive">
    @ViewBag.TB
    @grid.GetHtml(
        tableStyle: "table table-bordered table-hover",
        headerStyle: "webgrid-header",
        footerStyle: "grid-footer",
        fillEmptyRows: true,
        mode: WebGridPagerModes.Numeric,
        alternatingRowStyle: "alternatingRowStyle",
        columns: new[]  // colums in grid
        {
            grid.Column("STT",format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
            grid.Column("MaDongHo","Mã đồng hồ"),
            grid.Column("TenDongHo","Tên đồng hồ"),
            grid.Column("Giá bán",
                format: item => string.Format(
                    new System.Globalization.CultureInfo("vi-VN"),
                    "{0:N0}",
                    item.GiaBan
                )
            ),
            grid.Column("SoLuongTon","Số lượng tồn"),
          grid.Column("HinhAnh", "Hình ảnh", format: @<text>
    @{
        // 1. Tự động chuyển đổi tên file sang đuôi .webp để hiển thị
        var webpPath = !string.IsNullOrEmpty(item.HinhAnh)
                       ? System.IO.Path.ChangeExtension(item.HinhAnh, ".webp")
                       : "";
        var originalPath = item.HinhAnh;
    }

    <div class="image-container-admin">
        @if (!string.IsNullOrEmpty(originalPath))
        {
        <img src="~/Images/DongHo/@webpPath"
             alt="@item.TenDongHo"
             class="img-watch-admin"
             @* Nếu không có file .webp, nó sẽ tự động tìm file gốc (.jpg/.png) *@
             onerror="this.src='/Images/DongHo/@originalPath'; this.onerror=function(){this.src='/images/no-image.png';};" />
        }
        else
        {
        <div class="no-image-placeholder">No Image</div>
        }
    </div>
        </text>),
              grid.Column("BaoHanh","Bảo hành"),
              grid.Column("LoaiDongHo.TenLoai","Tên loại"),
              grid.Column("NoiSanXuat.TenNoiSanXuat","Nơi sản xuất"),
              grid.Column("ThuongHieu.TenThuongHieu","Thương hiệu"),

              grid.Column("Chức năng", format: @<text>
            <div class="d-flex justify-content-sm-around">
                @* Nút Edit *@
                <a href="@Url.Action("Edit", new { id = item.MaDongHo})" class="edit-btn">
                    <abbr title="Cập nhật dữ liệu"><img src="/images/edit.png" width="20" height="20" /></abbr>
                </a>
                <a href="@Url.Action("Details", new { id = item.MaDongHo})" class="details-btn">
                    <abbr title="Xem chi tiết dữ liệu"><img src="/images/file.png" width="20" height="20" /></abbr>
                </a>

                @* Nút Xóa: Kích hoạt Modal *@
                <a href="#"
                   class="delete-btn-trigger"
                   data-bs-toggle="modal"
                   data-bs-target="#deleteModal"
                   data-id="@item.MaDongHo"
                   data-url="@Url.Action("Delete", new { id = item.MaDongHo })">
                    <abbr title="Xóa dữ liệu">
                        <img src="/images/delete.png" width="20" height="20" />
                    </abbr>
                </a>
            </div>
            </text>),
}
)
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa đồng hồ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @using (Html.BeginForm("Delete", "DongHo_65131134", FormMethod.Post, new { id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa đồng hồ có Mã Đồng Hồ là <strong id="modal-ma-display"></strong> không?
                    <br />
                    <span class="text-danger small">Hành động này không thể hoàn tác.</span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    var deleteModal = document.getElementById('deleteModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (event) {
            // Button kích hoạt modal
            var button = event.relatedTarget;

            // Lấy dữ liệu từ attribute data-*
            var maDongHo = button.getAttribute('data-id');
            var deleteUrl = button.getAttribute('data-url');

            // Cập nhật nội dung hiển thị trong modal
            var modalMaDisplay = deleteModal.querySelector('#modal-ma-display');
            modalMaDisplay.textContent = maDongHo;

            // Cập nhật Action của Form để trỏ về đúng ID cần xóa
            var form = deleteModal.querySelector('#deleteForm');
            if (form) {
                form.setAttribute('action', deleteUrl);
            }
        });
    }
</script>