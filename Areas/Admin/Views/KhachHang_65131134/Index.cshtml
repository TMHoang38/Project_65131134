@model IEnumerable<Project_65131134.Models.KhachHang>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var grid = new WebGrid(Model, canPage: true, defaultSort: "MaKhachHang", rowsPerPage: 5);
}

<style>
    .action-icon {
        margin: 0 4px;
        display: inline-block;
    }

    a:hover {
        text-decoration: none;
    }
</style>


<h2 class="text-center">Danh sách khách hàng</h2>

<div class="btn btn-success mb-3">
    @Html.ActionLink("Thêm khách hàng mới", "Create", null, new { @style = "color: white;" })
</div>

<div id="gridContent">  
    @ViewBag.TB
    @grid.GetHtml(
        tableStyle: "table table-bordered table-hover",
        footerStyle: "grid-footer",
        fillEmptyRows: true,
        mode: WebGridPagerModes.Numeric,
        alternatingRowStyle: "alternatingRowStyle",
          columns: new[]  // colums in grid
         {
    grid.Column("MaKhachHang","Mã khách hàng"), //the model fields to display
    grid.Column("TenDangNhap","Tên đăng nhập"),
    grid.Column("MatKhau","Mật khẩu"),
    grid.Column("HoTen","Họ tên"  ),
    grid.Column("Email","Email"),
    grid.Column("SoDienThoai","Số điện thoại"),
    grid.Column("DiaChi","Địa chỉ"),
//grid.Column(format: (item) => Html.ActionLink("Cập nhật", "Edit", "SINHVIEN0720_65131134",new { id = item.MaSV },"SINHVIEN0720_65131134Controller")),
//grid.Column(format: (item) => Html.ActionLink("Xem chi tiết", "Details","SINHVIEN0720_65131134", new { id = item.MaSV },"SINHVIEN0720_65131134Controller")),
//grid.Column(format: (item) => Html.ActionLink("Xóa", "Delete","SINHVIEN0720_65131134", new { id = item.MaSV },"SINHVIEN0720_65131134Controller")),
                            grid.Column("Chức năng", format: @<text>
                                    <a href="@Url.Action("Edit",
                                                        new { id = item.MaKhachHang})" class="edit-btn"><abbr title="Cập nhật dữ liệu"><img src="/images/edit.png" width="20" height="20" /></abbr></a>                                 
                                    <a href="@Url.Action("Delete",
       new { id = item.MaKhachHang})"
                                       class="delete-btn"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng có Mã Khách Hàng là @item.MaKhachHang?');">
                                        <abbr title="Xóa dữ liệu">
                                            <img src="/images/delete.png" width="20" height="20" />
                                        </abbr>
                                    </a>
                                </text>),
                 }
                 )
</div>