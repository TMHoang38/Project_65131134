@model Project_65131134.Models.LoaiDongHo

@{
    ViewBag.Title = "Thêm loại đồng hồ mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    /* 1. Giao diện Card (Khung bao ngoài) */
    .card-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0,0,0,0.08);
    }

    .card-header-custom {
        background: linear-gradient(45deg, #4e73df, #224abe);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 20px;
    }

    .input-group {
        border-radius: 0.375rem;
        transition: all 0.2s;
        overflow: hidden;
    }

    .input-group-text {
        background-color: #f8f9fc;
        border-right: none;
        color: #4e73df;
        border-color: #d1d3e2;
        min-width: 45px;
        justify-content: center;
    }

    .input-group .form-control {
        border-left: none;
        color: #6e707e;
        border-color: #d1d3e2;
        position: relative;
        flex: 1 1 auto;
        width: 1% !important;
        margin-bottom: 0;
    }

        .input-group .form-control:focus {
            box-shadow: none !important;
            border-color: #d1d3e2;
            z-index: 3;
        }

    .input-group:focus-within {
        z-index: 5;
        border-radius: 0.375rem;
    }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control {
            border-color: #4e73df;
        }

    .btn-custom {
        border-radius: 50px;
        padding: 10px 30px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card card-custom">
                <div class="card-header card-header-custom text-center">
                    <h3 class="mb-0 fw-bold"><i class="fas fa-plus-circle me-2"></i> Thêm Loại Đồng Hồ Mới</h3>
                </div>
                <div class="card-body p-5">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-4" })

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Mã loại</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-id-card text-primary"></i></span>
                                    @Html.EditorFor(model => model.MaLoai, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @style = "background-color: #e9ecef" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.MaLoai, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Tên loại</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-tag text-primary"></i></span>
                                    @Html.EditorFor(model => model.TenLoai, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên loại" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.TenLoai, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-secondary">Mô tả</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-align-left text-primary"></i></span>
                                    @Html.EditorFor(model => model.MoTa, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập mô tả" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-center gap-3">
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-custom">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại
                            </a>

                            <button type="reset" class="btn btn-warning btn-custom text-white">
                                <i class="fas fa-sync-alt me-2"></i> Làm mới
                            </button>

                            <button type="submit" class="btn btn-primary btn-custom">
                                <i class="fas fa-save me-2"></i> Lưu loại đồng hồ
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
