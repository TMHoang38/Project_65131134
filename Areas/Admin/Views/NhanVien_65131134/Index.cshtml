@model IEnumerable<Project_65131134.Models.NhanVien>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var grid = new WebGrid(Model, canPage: true, defaultSort: "MaNhanVien", rowsPerPage: 5);
}

<style>

    .grid-footer {
        text-align: center;
        padding: 15px 0;
    }


        .grid-footer a {
            color: #007bff;
            text-decoration: none;
            padding: 8px 12px;
            margin: 0 4px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            display: inline-block;
            transition: background-color 0.3s, color 0.3s;
        }


            .grid-footer a[disabled],
            .grid-footer b, 
            .grid-footer a.webgrid-pager-current {
                background-color: #007bff;
                color: white; 
                border-color: #007bff;
                font-weight: bold;
                cursor: default;
            }


            .grid-footer a:not(.webgrid-pager-current):hover {
                background-color: #e9ecef;
                color: #0056b3;
            }
    .webgrid-header th {
        white-space: nowrap; 
        text-align: center; 
        vertical-align: middle;
    }
</style>

<h2 class="text-center my-4 text-primary fw-bold">Danh sách nhân viên</h2>

<div class="d-flex ">
    <div class="btn btn-success mb-3">
        @Html.ActionLink("Thêm nhân viên mới", "Create", null, new { @style = "color: white;" })
    </div>
    @using (Html.BeginForm("TimKiem", "NhanVien_65131134", FormMethod.Get, new { @class = "ms-auto d-none d-sm-inline-block form-inline my-2 my-md-0 mw-100 navbar-search border-4" }))
    {
        <div class="input-group">
            <input type="text" class="form-control bg-light small" name="hoTen" value="@ViewBag.hoTen" placeholder="Tìm kiếm tên nhân viên"
                             aria-label="Search" aria-describedby="basic-addon2">
            <div class="input-group-append">
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-search fa-sm"></i>
                </button>
            </div>
        </div>
    }
</div>

<div id="gridContent" class="table-responsive">
    @ViewBag.TB
    @grid.GetHtml(
        tableStyle: "table table-bordered table-hover",
        headerStyle: "webgrid-header",
        footerStyle: "grid-footer",
        fillEmptyRows: true,
        mode: WebGridPagerModes.Numeric,
        alternatingRowStyle: "alternatingRowStyle",
        columns: new[]  // colums in grid
        {
            grid.Column("STT",format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
            grid.Column("MaNhanVien","Mã nhân viên"),
            grid.Column("TenDangNhap","Tên đăng nhập"),
            grid.Column("MatKhau", "Mật khẩu", format: @<text>******</text>),
            grid.Column("HoTen","Họ tên" ),
            grid.Column("Email","Email"),
            grid.Column("SoDienThoai","Số điện thoại"),
            grid.Column("DiaChi","Địa chỉ"),
            grid.Column("Vai trò", format: @<text>
    @{
                    var roleText = "Không xác định";
          if (item.VaiTro != null)
          {
            var vaiTroValue = item.VaiTro.ToString();
            int vaiTroInt;
            if (int.TryParse(vaiTroValue, out vaiTroInt))
            {
              roleText = vaiTroInt == 0 ? "Quản lý"
                : vaiTroInt == 1 ? "Nhân viên bán hàng"
                : vaiTroInt == 2 ? "Nhân viên giao hàng"
                : "Không xác định";
            }
          }
    }
    @roleText
            </text>),
grid.Column("Ngày vào làm", format: @<text>
                @(item.NgayVaoLam.ToString("dd/MM/yyyy"))
</text>),

grid.Column("Chức năng", format: @<text>
    <div class="d-flex justify-content-sm-around">
        <span class="action-links">
            @* Nút Edit *@
            <a href="@Url.Action("Edit", new { id = item.MaNhanVien})" title="Cập nhật dữ liệu">
                <img src="/images/edit.png" width="20" height="20" />
            </a>

            @* Nút Xóa Mở Modal *@
            <a href="#"
               class="delete-btn-trigger"
               data-bs-toggle="modal"
               data-bs-target="#deleteModal"
               data-id="@item.MaNhanVien"
               data-url="@Url.Action("Delete", new { id = item.MaNhanVien })">
                <abbr title="Xóa dữ liệu">
                    <img src="/images/delete.png" width="20" height="20" />
                </abbr>
            </a>
        </span>
    </div>
</text>),
}
)
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa nhân viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @using (Html.BeginForm("Delete", "NhanVien_65131134", FormMethod.Post, new { id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa nhân viên có Mã Nhân Viên là <strong id="modal-ma-display"></strong> không?
                    <br />
                    <span class="text-danger small">Hành động này không thể hoàn tác.</span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </div>
            }
        </div>
    </div>
</div>
<script>
    var deleteModal = document.getElementById('deleteModal');

    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            var maNhanVien = button.getAttribute('data-id');
            var deleteUrl = button.getAttribute('data-url');

            var modalMaDisplay = deleteModal.querySelector('#modal-ma-display');
            if (modalMaDisplay) {
                modalMaDisplay.textContent = maNhanVien;
            }

            var form = deleteModal.querySelector('#deleteForm');
            if (form) {
                form.setAttribute('action', deleteUrl);
            }
        });
    }
</script>