@model Project_65131134.Models.NhanVien
@{
    ViewBag.Title = "Hồ sơ của tôi";
    var avatarUrl = "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.HoTen ?? "User") + "&background=4e73df&color=fff&size=150";
}

<style>
    /* CSS Tùy chỉnh để giao diện mượt mà hơn */
    .profile-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .profile-header-img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .form-control-custom {
        border-radius: 10px;
        padding: 12px 15px;
        border: 1px solid #e3e6f0;
        transition: all 0.3s;
    }

        .form-control-custom:focus {
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.15);
            border-color: #4e73df;
        }

    .input-group-text-custom {
        background: #f8f9fc;
        border: 1px solid #e3e6f0;
        border-radius: 10px 0 0 10px;
        color: #4e73df;
    }
    /* Bo góc cho input khi đi kèm icon */
    .input-group .form-control-custom {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .btn-custom {
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: 600;
        transition: transform 0.2s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
        }
</style>

<div class="row">
    <div class="col-xl-4 col-lg-5 mb-4">
        <div class="card shadow mb-4 profile-card text-center h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center py-5">
                <img src="@avatarUrl" class="rounded-circle profile-header-img mb-3" alt="Avatar">
                <h4 class="font-weight-bold text-dark mb-1">@Model.HoTen</h4>
                <p class="text-muted mb-3">@Model.Email</p>

                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary btn-sm rounded-pill px-4" href="@Url.Action("DoiMatKhau", "TaiKhoan_65131134")">
                        <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8 col-lg-7">
        <div class="card shadow mb-4 profile-card">
            <div class="card-header py-3 bg-white border-bottom-0">
                <h6 class="m-0 font-weight-bold text-primary text-uppercase small ls-1">Chỉnh sửa thông tin</h6>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @using (Html.BeginForm("ThongTinCaNhan", "TaiKhoan_65131134", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaNhanVien)

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold text-secondary">Họ và tên</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text input-group-text-custom"><i class="fas fa-user"></i></span>
                        </div>
                        @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control form-control-custom", placeholder = "Nhập họ tên của bạn" })
                    </div>
                    @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small pl-2" })
                </div>
                <div class="col-md-6 mb-4">
                    <label class="small mb-1 font-weight-bold text-secondary">Địa chỉ thường trú</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text input-group-text-custom"><i class="fas fa-map-marker-alt"></i></span>
                        </div>
                        @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control form-control-custom", placeholder = "Số nhà, tên đường, phường/xã..." })
                    </div>
                    @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger small pl-2" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold text-secondary">Địa chỉ Email</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text input-group-text-custom"><i class="fas fa-envelope"></i></span>
                        </div>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-custom", type = "email", placeholder = "name@example.com" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small pl-2" })
                </div>

                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold text-secondary">Số điện thoại</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text input-group-text-custom"><i class="fas fa-phone"></i></span>
                        </div>
                        @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control form-control-custom", placeholder = "09xx xxx xxx" })
                    </div>
                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small pl-2" })
                </div>


            </div>

                    <div class="d-flex justify-content-end mt-2">
                        <a class="btn btn-light btn-custom mr-2" href="@Url.Action("Index","NhanVien_65131134")">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary btn-custom shadow-sm">
                            <i class="fas fa-save mr-1"></i> Lưu thay đổi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>