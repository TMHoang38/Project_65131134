@model Project_65131134.Models.KhachHang

@{
    ViewBag.Title = "Chỉnh sửa thông tin";
    Layout = "~/Areas/NhanVienBanHang/Views/Shared/_Layout.cshtml";
}

<style>
    /* 1. Giao diện Card (Khung bao ngoài) */
    .card-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0,0,0,0.08);
    }

    .card-header-custom {
        background: linear-gradient(45deg, #4e73df, #224abe);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 20px;
    }

    .input-group {
        border-radius: 0.375rem;
        transition: all 0.2s;
        overflow: hidden;
    }

    .input-group-text {
        background-color: #f8f9fc;
        border-right: none;
        color: #4e73df;
        border-color: #d1d3e2;
        min-width: 45px;
        justify-content: center;
    }

    .input-group .form-control {
        border-left: none;
        color: #6e707e;
        border-color: #d1d3e2;
        position: relative;
        flex: 1 1 auto;
        width: 1% !important;
        margin-bottom: 0;
    }

        .input-group .form-control:focus {
            box-shadow: none !important;
            border-color: #d1d3e2;
            z-index: 3;
        }

        .input-group .form-control.is-invalid {
            border-color: #dc3545;
            background-image: none;
        }

    .input-group:focus-within {
        z-index: 5;
        border-radius: 0.375rem;
    }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control {
            border-color: #1cc88a;
        }

    .btn-custom {
        border-radius: 50px;
        padding: 10px 30px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    /* Style hiển thị lỗi */
    .invalid-feedback {
        display: none;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875em;
        color: #dc3545;
        padding-left: 0.5rem;
    }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card card-custom">
                <div class="card-header card-header-custom text-center">
                    <h3 class="mb-0 fw-bold"><i class="fas fa-user-edit me-2"></i> Chỉnh Sửa Thông Tin</h3>
                </div>
                <div class="card-body p-5">
                    @using (Html.BeginForm("Edit", "KhachHang_65131134", FormMethod.Post, new { id = "editForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-4" })

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Mã khách hàng</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                    @Html.TextBoxFor(model => model.MaKhachHang, new { @class = "form-control", @readonly = "readonly", @style = "background-color: #e9ecef", @id = "MaKhachHang" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Tên đăng nhập <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    @Html.EditorFor(model => model.TenDangNhap, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên đăng nhập", required = "required", @id = "TenDangNhap" } })
                                </div>
                                <div class="invalid-feedback"></div>
                                @Html.ValidationMessageFor(model => model.TenDangNhap, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Họ tên <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-signature"></i></span>
                                    @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập họ tên", required = "required" } })
                                </div>
                                <div class="invalid-feedback"></div>
                                @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Mật khẩu <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    @* Lưu ý: Trong Edit thường để trống mật khẩu nếu không muốn đổi *@
                                    @Html.EditorFor(model => model.MatKhau, new { htmlAttributes = new { @class = "form-control", @type = "password", @id = "MatKhau", placeholder = "Nhập mật khẩu mới (nếu muốn đổi)", required = "required" } })

                                    <span class="input-group-text bg-white border-left-0 toggle-password" style="cursor: pointer;" data-target="MatKhau">
                                        <i class="fas fa-eye text-muted"></i>
                                    </span>
                                </div>
                                <div class="invalid-feedback"></div>
                                @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "example@gmail.com", type = "email" } })
                                </div>
                                <div class="invalid-feedback"></div>
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    <input type="password" class="form-control" id="ConfirmMatKhau" name="ConfirmMatKhau" placeholder="Nhập lại mật khẩu" required />

                                    <span class="input-group-text bg-white border-left-0 toggle-password" style="cursor: pointer;" data-target="ConfirmMatKhau">
                                        <i class="fas fa-eye text-muted"></i>
                                    </span>
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Địa chỉ <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                    @Html.EditorFor(model => model.DiaChi, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập địa chỉ", required = "required" } })
                                </div>
                                <div class="invalid-feedback"></div>
                                @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control", placeholder = "09xx xxx xxx", required = "required" } })
                                </div>
                                <div class="invalid-feedback"></div>
                                @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <hr class="my-4" />
                        <div class="d-flex justify-content-center gap-3">
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-custom">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại
                            </a>
                            <button type="submit" id="submitBtn" class="btn btn-success btn-custom">
                                <i class="fas fa-save me-2"></i> Lưu thay đổi
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- 1. KIỂM TRA TRÙNG TÊN ĐĂNG NHẬP (LOGIC CŨ CỦA BẠN) ---
            const usernameInput = document.getElementById('TenDangNhap');
            const idInput = document.getElementById('MaKhachHang');

            if (usernameInput && idInput) {
                usernameInput.addEventListener('blur', function () {
                    const username = this.value.trim();
                    const currentId = idInput.value;

                    if (username.length > 0) {
                        checkUsernameAvailability(username, currentId, this);
                    }
                });

                usernameInput.addEventListener('input', function () {
                    clearFieldError(this);
                    this.removeAttribute('data-duplicate');
                });
            }

            // --- 2. LOGIC ẨN/HIỆN MẬT KHẨU (MỚI THÊM) ---
            document.querySelectorAll('.toggle-password').forEach(button => {
                button.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    const targetField = document.getElementById(targetId);
                    const eyeIcon = this.querySelector('i');
                    if (targetField) {
                        if (targetField.type === 'password') {
                            targetField.type = 'text';
                            eyeIcon.classList.replace('fa-eye', 'fa-eye-slash');
                        } else {
                            targetField.type = 'password';
                            eyeIcon.classList.replace('fa-eye-slash', 'fa-eye');
                        }
                    }
                });
            });

            // --- 3. XỬ LÝ SUBMIT FORM ---
            const form = document.getElementById('editForm');
            if (form) {
                form.addEventListener('submit', function (event) {
                    let isValid = true;
                    let firstErrorField = null;

                    // Check lỗi trùng tên
                    if (usernameInput && usernameInput.getAttribute('data-duplicate') === 'true') {
                        isValid = false;
                        showFieldError(usernameInput, 'Tên đăng nhập này đã tồn tại.');
                        if (!firstErrorField) firstErrorField = usernameInput;
                    }

                    // Check Mật khẩu khớp (MỚI THÊM)
                    const pass = document.getElementById('MatKhau');
                    const confirmPass = document.getElementById('ConfirmMatKhau');
                    if (pass && confirmPass && pass.value !== confirmPass.value) {
                        isValid = false;
                        showFieldError(confirmPass, 'Mật khẩu xác nhận không khớp');
                        if (!firstErrorField) firstErrorField = confirmPass;
                    }

                    // Check các trường required
                    const requiredFields = form.querySelectorAll('[required]');
                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            showFieldError(field, 'Không được để trống');
                            if (!firstErrorField) firstErrorField = field;
                        }
                    });

                    if (!isValid) {
                        event.preventDefault();
                        if (firstErrorField) firstErrorField.focus();
                    }
                });
            }

            // --- HÀM AJAX CHECK TRÙNG ---
            function checkUsernameAvailability(username, id, field) {
                $.ajax({
                    url: '/Admin/KhachHang_65131134/CheckUsername',
                    type: 'POST',
                    data: { username: username, id: id },
                    success: function (response) {
                        if (response.isTaken) {
                            showFieldError(field, 'Tên đăng nhập này đã được sử dụng bởi người khác.');
                            field.setAttribute('data-duplicate', 'true');
                        } else {
                            clearFieldError(field);
                            field.removeAttribute('data-duplicate');
                        }
                    },
                    error: function () {
                        console.log('Lỗi kết nối server.');
                    }
                });
            }

            // --- CÁC HÀM UI HELPERS ---
            function showFieldError(field, message) {
                field.classList.add('is-invalid');
                let parent = field.closest('.input-group') || field.parentElement;
                // Tìm invalid-feedback ngay sau input-group hoặc bên trong col
                let container = field.closest('.col-md-6');
                let errorContainer = container.querySelector('.invalid-feedback');

                if (errorContainer) {
                    errorContainer.textContent = message;
                    errorContainer.style.display = 'block';
                }
            }

            function clearFieldError(field) {
                field.classList.remove('is-invalid');
                let container = field.closest('.col-md-6');
                let errorContainer = container ? container.querySelector('.invalid-feedback') : null;
                if (errorContainer) {
                    errorContainer.style.display = 'none';
                }
            }
        });
    </script>
}