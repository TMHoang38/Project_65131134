    <title>Admin</title>

    <!-- Custom fonts for this template-->
    <link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom styles for this template-->
    <link href="~/Content/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="shortcut icon" type="image/jpeg" href="~/Images/logo-tab.png" />
    <link rel="icon" type="image/jpeg" href="~/Images/logo-tab.png" />

    <link rel="apple-touch-icon" href="~/Images/logo-tab.png">
    <style>
        .sidebar {
            background-color: #1e1e2d !important; /* Màu nền chính */
            min-height: 100vh;
            transition: all 0.3s;
        }

            .sidebar .nav-link {
                color: #a2a3b7 !important; /* Màu chữ nhạt */
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #2b2b40 !important; /* Màu khi di chuột vào hoặc đang chọn */
                    color: #ffffff !important;
                }
    </style>
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar - Thanh điều hướng chính bên trái -->
        <ul class="navbar-nav  sidebar accordion" id="accordionSidebar">
            <!-- Sidebar - Logo/Thương hiệu -->
            <div class="sidebar-brand-icon my-4 mx-3">
                <a href="@Url.Action("Index","DonHang_65131134", new { area = "NhanVienBanHang" })">
                    <img src="~/Images/logo.png" alt="Logo" style="max-height: 50px; width: auto;" class="img-fluid" />
                </a>

            </div>

            <!-- Đường phân cách -->
            <hr class="sidebar-divider my-0">

            <!-- Mục menu - Trang tổng quan (Dashboard) -->
            <!--<li class="nav-item active">
        <a class="nav-link" href="#">
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>Dashboard</span>
        </a>
    </li>-->
            <!-- Nav Item - Pages Collapse Menu -->
            <!-- Đường phân cách -->
            <!--<hr class="sidebar-divider">-->
            <!-- Tiêu đề nhóm menu -->
            <!--<div class="sidebar-heading">
        Interface
    </div>-->
            <!-- Mục menu - Thành phần giao diện (Components) -->
            @*<li class="nav-item">
            <a class="nav-link" href="#">
                <i class="bi bi-clipboard-data-fill"></i>
                <span>Thống kê</span>
            </a>
        </li>*@

            <!-- Mục menu - Tiện ích (Utilities) -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index","KhachHang_65131134", new { area = "NhanVienBanHang" })">
                    <i class="bi bi-people-fill"></i>
                    <span>Khách hàng</span>
                </a>
            </li>

            <!-- Đường phân cách -->
            <!--<hr class="sidebar-divider">-->
            <!-- Tiêu đề nhóm Addons -->
            <!--<div class="sidebar-heading">
        Addons
    </div>-->


            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index","DonHang_65131134", new { area = "NhanVienBanHang" })">
                    <i class="bi bi-bag-check-fill"></i>
                    <span>Đơn hàng</span>
                </a>
            </li>

            <!-- Đường phân cách chỉ hiện trên màn hình lớn -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Nút thu gọn sidebar -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>
        <!-- Kết thúc sidebar -->
        <!-- Khối nội dung chính bên phải -->
        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Nội dung chính -->
            <div id="content">
                <!-- Thanh topbar phía trên -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">
                                    @(!string.IsNullOrWhiteSpace(AuthenticationHelper.GetFullName())
                                        ? AuthenticationHelper.GetFullName()
                                        : AuthenticationHelper.GetUserName() ?? "Tài khoản")
                                </span>
                                <i class="bi bi-person-circle"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="@Url.Action("ThongTinCaNhan","TaiKhoan_65131134", new { area = "NhanVienBanHang" })">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Chỉnh sửa thông tin
                                </a>
                                <a class="dropdown-item" href="@Url.Action("DoiMatKhau","TaiKhoan_65131134", new { area = "NhanVienBanHang" })">
                                    <i class="fas fa-key fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Đổi mật khẩu
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("DangXuat","TaiKhoan_65131134", new { area = "NhanVienBanHang" })">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Đăng xuất
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                <!-- Kết thúc topbar -->

                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            <!-- Kết thúc nội dung chính -->
            <!-- Chân trang -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>&copy; @DateTime.Now.Year - Trần Minh Hoàng - 65131134</span>
                    </div>
                </div>
            </footer>
            <!-- Kết thúc chân trang -->
        </div>
        <!-- Kết thúc khối nội dung chính -->

    </div>
    <!-- Kết thúc Page Wrapper -->
    <!-- Nút cuộn lên đầu trang -->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Hộp thoại xác nhận đăng xuất -->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="@Url.Action("DangXuat","TaiKhoan_65131134", new { area = "NhanVienBanHang" })">Logout</a>
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <!-- Bootstrap core JavaScript-->
    <script src="~/Content/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/Content/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/Content/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="~/Content/vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/Content/js/demo/chart-area-demo.js"></script>
    <script src="~/Content/js/demo/chart-pie-demo.js"></script>

    <!-- Render page-specific scripts AFTER all libraries are loaded -->
    @RenderSection("scripts", required: false)

