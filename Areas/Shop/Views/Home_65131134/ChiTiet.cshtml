@model Project_65131134.Models.DongHo
@using Project_65131134.Helpers

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="product-image-container bg-white p-4 shadow-sm rounded">
                    @{
                        var webpPath = !string.IsNullOrEmpty(Model.HinhAnh) ? System.IO.Path.ChangeExtension(Model.HinhAnh, ".webp") : "";
                        var originalPath = Model.HinhAnh;
                        var imagePath = !string.IsNullOrEmpty(webpPath) ? Url.Content("~/Images/DongHo/" + webpPath) : (!string.IsNullOrEmpty(originalPath) ? Url.Content("~/Images/DongHo/" + originalPath) : Url.Content("~/images/no-image.png"));
                    }
                    <img src="@imagePath" alt="@Model.TenDongHo" class="img-fluid w-100"
                         onerror="this.src='@Url.Content("~/Images/DongHo/" + originalPath)'; this.onerror=function(){this.src='@Url.Content("~/images/no-image.png")';};"
                         style="max-height: 600px; object-fit: contain;" />
                </div>

                @if (!string.IsNullOrEmpty(Model.MoTa))
                {
                    <div class="bg-white p-4 shadow-sm rounded mt-4">
                        <h3 class="h4 fw-bold mb-3 text-black">Mô tả sản phẩm</h3>
                        <div class="product-description">
                            @Html.Raw(Model.MoTa.Replace("\n", "<br />"))
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <div class="product-info bg-white p-4 shadow-sm rounded">
                    <h1 class="h2 fw-bold mb-3 text-uppercase text-black">@Model.TenDongHo</h1>

                    <div class="mb-4">
                        <span class="h3 text-danger fw-bold">Giá bán @string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:N0}", Model.GiaBan) ₫</span>
                    </div>

                    <div class="product-details mb-4">
                        <table class="table table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-black" style="width: 40%;">Mã sản phẩm:</td>
                                    <td>@Model.MaDongHo</td>
                                </tr>
                                @if (Model.ThuongHieu != null)
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Thương hiệu:</td>
                                        <td>@Model.ThuongHieu.TenThuongHieu</td>
                                    </tr>
                                }
                                @if (Model.LoaiDongHo != null)
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Thể loại:</td>
                                        <td>@Model.LoaiDongHo.TenLoai</td>
                                    </tr>
                                }
                                @if (Model.ChatLieuDay != null)
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Chất liệu dây:</td>
                                        <td>@Model.ChatLieuDay.TenChatLieu</td>
                                    </tr>
                                }
                                @if (Model.ChatLieuVo != null)
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Chất liệu vỏ:</td>
                                        <td>@Model.ChatLieuVo.TenChatLieu</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.MauSac))
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Màu sắc:</td>
                                        <td>@Model.MauSac</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.KichThuoc))
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Kích thước:</td>
                                        <td>@Model.KichThuoc</td>
                                    </tr>
                                }
                                @if (Model.BaoHanh.HasValue)
                                {
                                    <tr>
                                        <td class="fw-bold text-black">Bảo hành:</td>
                                        <td>@Model.BaoHanh tháng</td>
                                    </tr>
                                }
                                <tr>
                                    <td class="fw-bold text-black">Tình trạng:</td>
                                    <td>
                                        @if (Model.SoLuongTon > 0)
                                        {
                                            <span class="text-danger fw-bold">Còn hàng</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Hết hàng</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="service-features mb-4">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><i class="bi bi-globe text-danger me-2"></i>Free Ship Toàn Quốc</li>
                            <li class="mb-2"><i class="bi bi-shield-check text-danger me-2"></i>Bảo Hành Chính Hãng</li>
                            <li class="mb-2"><i class="bi bi-bag text-danger me-2"></i>Trả Góp Lãi Suất 0% Qua Fundiin</li>
                            <li class="mb-2"><i class="bi bi-tag text-danger me-2"></i>Đổi Trả Miễn Phí Trong 07 Ngày</li>
                        </ul>
                    </div>

                    <div class="action-buttons">
                        @if (AuthenticationHelper.IsLoggedIn() && AuthenticationHelper.IsKhachHang())
                        {
                            if (Model.SoLuongTon > 0)
                            {
                                <div class="mb-4">

                                    <div class="d-flex align-items-center">
                                        <label class="fw-bold text-black me-2 d-block">Số lượng:</label>
                                        <div class="quantity-wrapper d-flex shadow-sm">
                                            <button class="qty-btn" type="button" id="btnMinus">−</button>
                                            <input type="number" id="txtQuantity" class="qty-input" value="1" min="1" readonly>
                                            <button class="qty-btn" type="button" id="btnPlus">+</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button class="btn btn-primary btn-lg fw-bold add-to-cart-detail-btn" data-ma-dong-ho="@Model.MaDongHo" data-ten-dong-ho="@Model.TenDongHo">
                                        <i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ hàng
                                    </button>
                                    <button class="btn btn-danger btn-lg fw-bold buy-now-btn" data-ma-dong-ho="@Model.MaDongHo">
                                        <i class="bi bi-bag-check me-2"></i>Đặt mua ngay
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">Sản phẩm hiện đang hết hàng</div>
                            }
                        }
                        else
                        {
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("Index", "DangNhap_65131134", new { area = "TaiKhoan" })" class="btn btn-primary btn-lg fw-bold">
                                    <i class="bi bi-cart-plus me-2"></i>Đăng nhập để mua hàng
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .swal2-toast {
        border-radius: 12px !important;
        padding: 15px !important;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
    }

    .swal2-success-circular-line-left, .swal2-success-circular-line-right, .swal2-success-fix {
        display: none !important; /* Ẩn các hiệu ứng thừa để icon tối giản giống ảnh */
    }
    .product-image-container {
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-info {
        height: 100%;
    }

    .product-details table td {
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .product-details table tr:last-child td {
        border-bottom: none;
    }

    .service-features li {
        font-size: 0.95rem;
    }

    .service-features i {
        font-size: 1.2rem;
    }

    .action-buttons .btn {
        border-radius: 8px;
        padding: 12px 24px;
    }

    .product-description {
        line-height: 1.8;
        color: #555;
    }

    /* CSS FIX CHO BỘ CHỌN SỐ LƯỢNG ĐỐI XỨNG */
    .quantity-wrapper {
        border: 1px solid #ced4da;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
    }

    .qty-btn {
        width: 45px;
        height: 45px;
        border: none;
        background-color: #ffc107; /* Màu vàng giống nút cũ */
        color: #000;
        font-weight: bold;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .qty-btn:hover {
            background-color: #e0a800;
        }

        .qty-btn:active {
            background-color: #d39e00;
        }

    .qty-input {
        width: 60px;
        height: 45px;
        text-align: center;
        border: none;
        border-left: 1px solid #eee;
        border-right: 1px solid #eee;
        font-weight: bold;
        font-size: 1.1rem;
        background-color: #fff;
        -moz-appearance: textfield;
    }

        /* Ẩn mũi tên mặc định của input number */
        .qty-input::-webkit-outer-spin-button,
        .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .see-more-btn, .see-less-btn {
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .see-more-btn:hover, .see-less-btn:hover {
            color: #C5A059 !important;
            text-decoration: underline !important;
        }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // 1. Cấu hình Toast giống hệt hình ảnh bạn gửi
            const CartToast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            // 2. Xử lý tăng giảm số lượng (giữ nguyên của bạn)
            $('#btnPlus').on('click', function() {
                let val = parseInt($('#txtQuantity').val());
                $('#txtQuantity').val(val + 1);
            });

            $('#btnMinus').on('click', function() {
                let val = parseInt($('#txtQuantity').val());
                if (val > 1) {
                    $('#txtQuantity').val(val - 1);
                }
            });

            // 3. Xử lý Thêm vào giỏ hàng
            $('.add-to-cart-detail-btn').on('click', function (e) {
                e.preventDefault();
                var btn = $(this);
                var maDongHo = btn.data('ma-dong-ho');
                var tenDongHo = btn.data('ten-dong-ho'); // Lấy tên đồng hồ từ data attribute
                var soLuong = $('#txtQuantity').val();

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang thêm...');

                $.ajax({
                    url: '@Url.Action("AddToCart", "Home_65131134")',
                    type: 'POST',
                    data: {
                        maDongHo: maDongHo,
                        soLuong: soLuong
                    },
                    success: function (response) {
                        if (response.success) {
                            // HIỆN THÔNG BÁO NHƯ TRONG ẢNH
                            CartToast.fire({
                                icon: 'success',
                                title: '<span style="color: #444; font-weight: bold; font-size: 1.2rem;">Đã thêm vào giỏ hàng</span>',
                                html: '<span style="color: #888; font-size: 1rem;">' + tenDongHo + '</span>',
                                iconColor: '#C5A059', // Màu vàng đồng/gold
                                background: '#fff',
                                width: '350px'
                            });

                            // Cập nhật số lượng trên icon giỏ hàng
                            if (typeof updateCartCount === "function") {
                                updateCartCount(response.cartCount);
                            }

                            btn.prop('disabled', false).html('<i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ hàng');
                        } else {
                            if (response.requireLogin) {
                                window.location.href = '@Url.Action("Index", "DangNhap_65131134", new { area = "TaiKhoan" })';
                            } else {
                                Swal.fire({ icon: 'error', title: 'Lỗi', text: response.message });
                                btn.prop('disabled', false).html('<i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ hàng');
                            }
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra. Vui lòng thử lại!' });
                        btn.prop('disabled', false).html('<i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ hàng');
                    }
                });
            });

            // Đặt mua ngay - Chuyển thẳng đến thanh toán
            $('.buy-now-btn').on('click', function (e) {
                e.preventDefault();
                var btn = $(this);
                var maDongHo = $(this).data('ma-dong-ho');
                var soLuong = parseInt($('#txtQuantity').val()) || 1;
                
                if (soLuong < 1) {
                    Swal.fire({ icon: 'warning', title: 'Cảnh báo', text: 'Số lượng phải lớn hơn 0!' });
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');

                // Chuyển đến action BuyNow
                window.location.href = '@Url.Action("BuyNow", "KhachHang_65131134", new { area = "Shop" })' + '?maDongHo=' + maDongHo + '&soLuong=' + soLuong;
            });
        });
    </script>
}