<section class="py-6 bg-soft-white" id="collections">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fs-2 fw-bolder text-uppercase mb-2 text-dark tracking-tight fs-4">Đồng Hồ Thời Trang</h2>
            <hr class="mx-auto border-warning border-3" style="width: 35%;">
        </div>

        <div class="filter-wrapper shadow-lg p-4 bg-white">
            <form id="filterForm" method="get" action="@Url.Action("Index", "Home_65131134")" class="row g-3">
                <div class="col-md-auto">
                    <button type="button" id="btnReset" class="btn btn-dark w-100 h-100">Tất cả</button>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" id="searchTerm" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm tên..." />
                    </div>
                </div>
                <div class="col-md-3">
                    @Html.DropDownList("brandId", (SelectList)ViewBag.BrandList, "Thương hiệu", new { @class = "form-select custom-select", id = "brandId" })
                </div>
                <div class="col-md-3">
                    <select name="priceRange" id="priceRange" class="form-select custom-select">
                        <option value="">Khoảng giá</option>
                        <option value="lt5" @(ViewBag.PriceRange == "lt5" ? "selected" : "")>Dưới 5 triệu</option>
                        <option value="5to10" @(ViewBag.PriceRange == "5to10" ? "selected" : "")>5 - 10 triệu</option>
                        <option value="10to50" @(ViewBag.PriceRange == "10to50" ? "selected" : "")>10 - 50 triệu</option>
                        <option value="50to100" @(ViewBag.PriceRange == "50to100" ? "selected" : "")>50 - 100 triệu</option>
                        <option value="gt100" @(ViewBag.PriceRange == "gt100" ? "selected" : "")>Trên 100 triệu</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-gold w-100 fw-bold p-2 h-100 w-200 px-4" type="submit">TÌM KIẾM</button>
                </div>
            </form>
        </div>

        <div class="row" id="productsGrid">
            @Html.Partial("_DongHoListPartial", Model)
        </div>
    </div>
</section>
<style>
    :root {
        --gold: #C5A059;
        --gold-dark: #A68545;
        --black: #111111;
        --soft-white: #f8f9fa;
    }

    /* General Refinements */
    .text-gold {
        color: var(--gold) !important;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    .bg-soft-white {
        background-color: var(--soft-white);
    }

    .gold-divider {
        width: 60px;
        height: 3px;
        background-color: var(--gold);
        transition: width 0.3s ease;
    }

    /* Hero Section */
    .hero-overlay {
        filter: brightness(0.6);
    }

    /* Buttons */
    .btn-gold {
        background-color: var(--gold);
        color: white;
        border: none;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-gold:hover {
            background-color: var(--gold-dark);
            transform: translateY(-2px);
            color: white;
        }

    .btn-gold-outline {
        border: 1px solid var(--gold);
        color: var(--gold);
        background: transparent;
        text-transform: uppercase;
    }

        .btn-gold-outline:hover {
            background: var(--gold);
            color: white;
        }

    .btn-carousel {
        background: transparent;
        border: 1px solid var(--gold);
        color: var(--gold);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        transition: all 0.3s;
    }

        .btn-carousel:hover {
            background: var(--gold);
            color: white;
        }

    /* Form Styling */
    .filter-wrapper {
        border-radius: 15px;
        margin-top: -50px;
        position: relative;
        z-index: 10;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .custom-select, .form-control {
        border: 1px solid #e0e0e0;
        padding: 10px 15px;
        font-size: 0.9rem;
    }

        .custom-select:focus, .form-control:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 0.2rem rgba(197, 160, 89, 0.15);
        }

    /* Product Cards (Assuming they are in the Partial) */
    .product-card {
        border: none !important;
        background: #fff;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .border-gold-left {
        border-left: 5px solid var(--gold);
        padding-left: 0;
    }

    /* Animation cho list sản phẩm khi load AJAX */
    #productsGrid {
        transition: opacity 0.4s ease;
    }

</style>

@section scripts {
    <script>
        $(document).ready(function () {
            // Hàm thực hiện lọc AJAX
            function performFilter() {
                var formData = $('#filterForm').serialize();
                var url = $('#filterForm').attr('action');

                // Hiệu ứng loading mờ
                $('#productsGrid').css('opacity', '0.5');

                $.ajax({
                    url: url,
                    type: 'GET',
                    data: formData,
                    success: function (result) {
                        $('#productsGrid').html(result);
                        $('#productsGrid').css('opacity', '1');
                    },
                    error: function () {
                        alert('Không thể tải dữ liệu.');
                        $('#productsGrid').css('opacity', '1');
                    }
                });
            }

            // Bắt sự kiện Submit form
            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                performFilter();
            });

            // Nút reset "Tất cả"
            $('#btnReset').click(function() {
                $('#searchTerm').val('');
                $('#brandId').val('');
                $('#priceRange').val('');
                performFilter();
            });

            // Add to Cart AJAX (Sử dụng Delegation vì danh sách sẽ bị thay thế)
            $(document).on('click', '.add-to-cart-btn', function (e) {
                e.preventDefault();
                var btn = $(this);
                var maDongHo = btn.data('ma-dong-ho');
                $.post('@Url.Action("AddToCart", "Home_65131134")', { maDongHo: maDongHo }, function (response) {
                    if (response.success) {
                        alert(response.message);
                        updateCartCount();
                    } else {
                        if (response.requireLogin) window.location.href = '@Url.Action("Index", "DangNhap_65131134", new { area = "TaiKhoan" })';
                        else alert(response.message);
                    }
                });
            });

            function updateCartCount() {
                $.get('@Url.Action("GetCartCount", "Home_65131134")', function(data) {
                    var cartBadge = $('#cartBadge');
                    if(data.cartCount > 0) {
                        cartBadge.text(data.cartCount).show();
                    } else {
                        cartBadge.hide();
                    }
                });
            }
        });
    </script>
}