@using Project_65131134.Helpers
@model Project_65131134.Models.ViewModels.DongHoPaginationViewModel
@{
    ViewBag.Title = "Thế Giới Đồng Hồ Cao Cấp";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<section class="py-0 bg-black position-relative" id="header">
    <div class="bg-holder hero-overlay" style="background-image:url(@Url.Content("~/assets/img/gallery/header-bg.png"));background-position:right center;background-size:contain;"></div>
    <div class="container">
        <div class="row align-items-center min-vh-75 min-vh-xl-100">
            <div class="col-md-8 col-lg-6 text-md-start text-center z-index-2">
                @if (AuthenticationHelper.IsLoggedIn() && AuthenticationHelper.IsKhachHang())
                {
                    <p class="text-uppercase text-gold fw-bold mb-2 tracking-widest">Chào mừng trở lại</p>
                }
                <h1 class="display-2 lh-sm text-uppercase text-light fw-bold">Nâng Tầm <span class="text-gold">Đẳng Cấp</span> <br /> Thời Gian</h1>
                <p class="text-light opacity-75 fs-1 mb-4">Khám phá bộ sưu tập đồng hồ chế tác thủ công tinh xảo dành riêng cho bạn.</p>
                <div class="pt-2">
                    <a class="btn btn-gold-outline px-4 py-2 me-3" href="#collections">BỘ SƯU TẬP</a>
                    <a class="btn btn-gold px-4 py-2" href="#store">CỬA HÀNG</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-black py-8 pt-0" id="store">
    <div class="bg-holder" style="background-image:url(@Url.Content("~/assets/img/gallery/store-bg.png")); background-position:left bottom; background-size:contain;"></div>
    <div class="container-lg">
        <div class="row flex-end-center">
            <div class="col-sm-10 col-md-6 col-lg-6 text-center text-md-start">
                <div class="col-4 position-relative ms-auto py-5">
                    <a class="carousel-control-prev carousel-icon z-index-2" href="#carouselExampleFade" role="button" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span></a>
                    <a class="carousel-control-next carousel-icon z-index-2" href="#carouselExampleFade" role="button" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span></a>
                </div>
                <div class="carousel slide carousel-fade me-auto" id="carouselExampleFade" data-bs-ride="carousel">
                    <div class="carousel-inner ">
                        <div class="carousel-item active">
                            <h5 class="fs-3 fs-lg-5 lh-sm text-uppercase text-white">Chất lượng đỉnh cao</h5>
                            <p class="text-light opacity-75 my-4 pe-xl-5">Mỗi chiếc đồng hồ là một kiệt tác nghệ thuật, được kiểm định khắt khe trước khi đến tay khách hàng.</p>
                        </div>
                        <div class="carousel-item">
                            <h5 class="fs-3 fs-lg-5 lh-sm text-uppercase text-white">Dịch vụ tận tâm</h5>
                            <p class="text-light opacity-75 my-4 pe-xl-5">Bảo hành chính hãng toàn cầu lên đến 5 năm cùng dịch vụ thay pin miễn phí trọn đời.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6 bg-soft-white" id="collections">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fs-2 fw-bolder text-uppercase mb-2 text-dark tracking-tight fs-4">Đồng Hồ Thời Trang</h2>
            <hr class="mx-auto border-warning border-3" style="width: 35%;">
        </div>

        <div class="filter-wrapper shadow-lg p-4 bg-white">
            <form id="filterForm" method="get" action="@Url.Action("Index", "Home_65131134")" class="row g-3">
                <input type="hidden" name="page" id="currentPage" value="1" />
                <div class="col-md-auto">
                    <button type="button" id="btnReset" class="btn btn-dark w-100 h-100 px-4">Tất cả</button>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" id="searchTerm" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm tên..." />
                    </div>
                </div>
                <div class="col-md-3">
                    @Html.DropDownList("brandId", (SelectList)ViewBag.BrandList, "Thương hiệu", new { @class = "form-select custom-select", id = "brandId" })
                </div>
                <div class="col-md-3">
                    <select name="priceRange" id="priceRange" class="form-select custom-select">
                        <option value="">Khoảng giá</option>
                        <option value="lt5" @(ViewBag.PriceRange == "lt5" ? "selected" : "")>Dưới 5 triệu</option>
                        <option value="5to10" @(ViewBag.PriceRange == "5to10" ? "selected" : "")>5 - 10 triệu</option>
                        <option value="10to50" @(ViewBag.PriceRange == "10to50" ? "selected" : "")>10 - 50 triệu</option>
                        <option value="gt100" @(ViewBag.PriceRange == "gt100" ? "selected" : "")>Trên 100 triệu</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-gold w-100 fw-bold px-4 h-100" type="submit">TÌM KIẾM</button>
                </div>
            </form>
        </div>

        <div class="row mt-5" id="productsGrid">
            @Html.Partial("_DongHoListPartial", Model)
        </div>
    </div>
</section>

<style>
    :root {
        --gold: #C5A059;
        --gold-dark: #A68545;
        --black: #111111;
        --soft-white: #f8f9fa;
    }

    .text-gold {
        color: var(--gold) !important;
    }

    .bg-soft-white {
        background-color: var(--soft-white);
    }

    .btn-gold {
        background-color: var(--gold);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gold:hover {
            background-color: var(--gold-dark);
            transform: translateY(-2px);
            color: white;
        }

    .btn-gold-outline {
        border: 1px solid var(--gold);
        color: var(--gold);
        background: transparent;
    }

        .btn-gold-outline:hover {
            background: var(--gold);
            color: white;
        }

    .filter-wrapper {
        border-radius: 15px;
        margin-top: -50px;
        position: relative;
        z-index: 10;
        background: white;
    }

    #productsGrid {
        transition: opacity 0.4s ease;
    }

    .pagination .page-item.active .page-link {
        background-color: var(--gold);
        border-color: var(--gold);
        color: white;
    }

    .pagination .page-link {
        color: var(--black);
    }
</style>

@section scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true
            });

            // Hàm lọc AJAX chính - Đã sửa lỗi tham số page
            window.performFilter = function(pageNumber) {
                // 1. Cập nhật giá trị vào input hidden
                $('#currentPage').val(pageNumber);

                // 2. Lấy dữ liệu từ form và thêm page vào
                var formData = $('#filterForm').serializeArray();
                // Xóa page cũ nếu có
                formData = formData.filter(function(item) { return item.name !== 'page'; });
                // Thêm page mới
                formData.push({ name: 'page', value: pageNumber });
                
                var url = $('#filterForm').attr('action');

                $('#productsGrid').css('opacity', '0.5');

                $.ajax({
                    url: url,
                    type: 'GET',
                    data: $.param(formData), // Chuyển array thành query string
                    success: function (result) {
                        $('#productsGrid').html(result);
                        $('#productsGrid').css('opacity', '1');

                        // Cuộn lên đầu danh sách
                        $('html, body').animate({
                            scrollTop: $("#collections").offset().top - 100
                        }, 200);
                    },
                    error: function () {
                        Toast.fire({ icon: 'error', title: 'Không thể tải dữ liệu.' });
                        $('#productsGrid').css('opacity', '1');
                    }
                });
            }

            // Sự kiện Submit Form (Tìm kiếm mới luôn về trang 1)
            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                performFilter(1);
            });

            // Nút Reset
            $('#btnReset').click(function () {
                $('#searchTerm').val('');
                $('#brandId').val('');
                $('#priceRange').val('');
                performFilter(1);
            });

            // Thêm vào giỏ hàng
            $(document).on('click', '.add-to-cart-btn', function (e) {
                e.preventDefault();
                var btn = $(this);
                var maDongHo = btn.data('ma-dong-ho');
                var tenDongHo = btn.data('ten-dong-ho') || "Sản phẩm";

                btn.prop('disabled', true);
                $.post('@Url.Action("AddToCart", "Home_65131134")', { maDongHo: maDongHo }, function (response) {
                    if (response.success) {
                        Toast.fire({
                            icon: 'success',
                            title: 'Đã thêm vào giỏ hàng',
                            text: tenDongHo,
                            iconColor: '#C5A059'
                        });
                        if (typeof updateCartCount === "function") updateCartCount(response.cartCount);
                    } else if (response.requireLogin) {
                        window.location.href = '@Url.Action("Index", "DangNhap_65131134", new { area = "TaiKhoan" })';
                    } else {
                        Toast.fire({ icon: 'error', title: response.message });
                    }
                }).always(() => btn.prop('disabled', false));
            });
        });

        function updateCartCount(count) {
            var badge = $('.cart-badge, #cartBadge, .badge-cart');
            if(count > 0) badge.text(count).show();
            else badge.hide();
        }
    </script>
}