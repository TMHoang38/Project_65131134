@model Project_65131134.Models.KhachHang
@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Chỉnh sửa phông nền sáng đồng bộ với trang Đổi mật khẩu */
    .profile-section {
        background-color: #f8f9fa; /* Nền xám cực nhẹ */
        min-height: 85vh;
        display: flex;
        align-items: center;
    }

    .card-custom {
        border: none;
        border-radius: 15px;
        overflow: visible; /* Cho phép avatar trồi lên */
        background: #ffffff;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 15px 15px 0 0;
        padding: 30px 20px;
    }

    /* Avatar circle chỉnh lại để nổi bật trên nền sáng */
    .avatar-circle {
        width: 100px;
        height: 100px;
        background: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: -50px auto 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        border: 4px solid #fff;
    }

        .avatar-circle i {
            color: #764ba2; /* Màu icon trùng màu gradient chính */
        }

    /* Input style đồng bộ */
    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
        border-color: #764ba2;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
        color: #6c757d;
    }

    .form-control {
        border-left: none;
        background-color: #ffffff;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(118, 75, 162, 0.4);
            color: white;
        }
</style>

<section class="profile-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card card-custom shadow-lg mt-2">

                    <div class="card-header-custom text-center text-white">
                        <h3 class="card-title mb-0 fw-bold">HỒ SƠ CỦA BẠN</h3>
                    </div>

                    <div class="card-body p-4 pt-3">
                        <div class="avatar-circle">
                            <i class="fas fa-user fa-3x"></i>
                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                <div>@TempData["SuccessMessage"]</div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @using (Html.BeginForm("ChinhSuaHoSo", "KhachHang_65131134", FormMethod.Post, new { area = "Shop", @class = "needs-validation", novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.MaKhachHang)

                            <div class="mb-3 mt-3">
                                @Html.LabelFor(m => m.HoTen, new { @class = "form-label fw-bold text-secondary" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                    @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nhập họ và tên" })
                                </div>
                                @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold text-secondary" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "name@example.com" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.SoDienThoai, new { @class = "form-label fw-bold text-secondary" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                                </div>
                                @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="mb-4">
                                @Html.LabelFor(m => m.DiaChi, new { @class = "form-label fw-bold text-secondary" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                    @Html.TextAreaFor(m => m.DiaChi, 2, 50, new { @class = "form-control", placeholder = "Nhập địa chỉ giao hàng" })
                                </div>
                                @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-gradient py-2 fw-bold">
                                    <i class="fas fa-save me-2"></i> Lưu Thay Đổi
                                </button>
                                <div class="row g-2">
                                    <div class="col-12">
                                        <a href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })" class="btn btn-light w-100 py-2 text-secondary">
                                            <i class="fas fa-home me-1"></i> Trang chủ
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    setTimeout(function () {
        let alertNode = document.querySelector('.alert');
        if (alertNode) {
            let alert = new bootstrap.Alert(alertNode);
            alert.close();
        }
    }, 3000);
</script>