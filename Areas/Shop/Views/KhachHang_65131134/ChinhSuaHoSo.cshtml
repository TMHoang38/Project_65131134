@model Project_65131134.Models.KhachHang
@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<section class="profile-container">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home_65131134")" class="text-decoration-none">Cửa hàng</a></li>
                        <li class="breadcrumb-item active">Thông tin cá nhân</li>
                    </ol>
                </nav>
                <h2 class="fw-bold m-0" style="color: #2d3748;">Hồ sơ của tôi</h2>
            </div>
            <a href="@Url.Action("DonHangCuaToi", "KhachHang_65131134", new { area = "Shop" })" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fas fa-history me-1"></i> Lịch sử đơn hàng
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card-custom">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
                            <i class="fas fa-check-circle me-3 fa-lg"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("ChinhSuaHoSo", "KhachHang_65131134", FormMethod.Post, new { area = "Shop" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.MaKhachHang)

                        <div class="row">
                            <div class="col-md-4 border-end">
                                <div class="avatar-section">
                                    <div class="avatar-circle">
                                        <i class="fas fa-user fa-3x"></i>
                                    </div>
                                    <h5 class="mt-3 fw-bold text-dark mb-1">@Model.HoTen</h5>
                                    <p class="text-muted small">Khách hàng thành viên</p>
                                    <hr class="my-4 mx-4 opacity-5" />
                                    <a href="@Url.Action("DoiMatKhau", "KhachHang_65131134", new { area = "Shop" })" class="btn btn-light btn-sm w-100 rounded-pill text-primary fw-bold">
                                        <i class="fas fa-key me-2"></i> Đổi mật khẩu
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-8 ps-md-5">
                                <div class="row">
                                    <div class="col-md-12 mb-4">
                                        <label class="form-label">Họ và tên</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nhập họ tên" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <label class="form-label">Email liên hệ</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "example@mail.com" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <label class="form-label">Số điện thoại</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "Số điện thoại" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 mb-5">
                                        <label class="form-label">Địa chỉ nhận hàng</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                            @Html.TextAreaFor(m => m.DiaChi, new { @class = "form-control", rows = "3", placeholder = "Số nhà, tên đường, phường/xã..." })
                                        </div>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary btn-save shadow-sm">
                                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>


<style>
    body {
        background-color: #f4f7f6;
        color: #444;
    }

    .profile-container {
        padding-top: 3rem;
        padding-bottom: 5rem;
    }

    .card-custom {
        background: #ffffff;
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        padding: 2.5rem;
    }

    .avatar-section {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .avatar-circle {
        width: 100px;
        height: 100px;
        background: #eef2ff;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #4338ca;
        border: 4px solid #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .form-label {
        color: #718096;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        background-color: #f8f9fa;
        color: #2d3748;
        font-weight: 500;
    }

        .form-control:focus {
            background-color: #fff;
            border-color: #4338ca;
            box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.1);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border: 1px solid #e2e8f0;
        color: #a0aec0;
        border-radius: 8px 0 0 8px;
        padding-left: 1.2rem;
        padding-right: 1.2rem;
    }

    .btn-save {
        border-radius: 8px;
        padding: 0.8rem 2.5rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s;
    }
</style>
