@model Project_65131134.Models.DoiMatKhauViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background-color: #f4f7f6;
    }

    .password-container {
        padding-top: 3rem;
        padding-bottom: 5rem;
    }

    .card-custom {
        background: #ffffff;
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        padding: 3rem;
    }

    .form-label {
        color: #718096;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        font-weight: 500;
    }

        .form-control:focus {
            border-color: #4338ca;
            box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.1);
        }

    .input-group-text {
        background-color: #f8f9fa;
        color: #a0aec0;
        border: 1px solid #e2e8f0;
        border-radius: 8px 0 0 8px;
        min-width: 45px;
        justify-content: center;
    }

    .btn-toggle-password {
        border: 1px solid #e2e8f0;
        border-left: none;
        background: #f8f9fa;
        color: #718096;
        padding-left: 15px;
        padding-right: 15px;
    }

    .btn-submit {
        border-radius: 8px;
        padding: 0.9rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all 0.3s;
    }

    .security-icon-circle {
        width: 80px;
        height: 80px;
        background: #fff5f5;
        color: #e53e3e;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }
</style>

<section class="password-container">
    <div class="container">
        <div class="mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home_65131134")" class="text-decoration-none">Cửa hàng</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ChinhSuaHoSo", "KhachHang_65131134")" class="text-decoration-none">Hồ sơ</a></li>
                    <li class="breadcrumb-item active">Bảo mật</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0" style="color: #2d3748;">Đổi mật khẩu</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="card-custom text-center">
                    <div class="security-icon-circle">
                        <i class="fas fa-shield-alt fa-2x"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Cập nhật mật khẩu</h4>
                    <p class="text-muted small mb-5">Đảm bảo tài khoản của bạn được sử dụng mật khẩu mạnh để bảo mật thông tin.</p>

                    @using (Html.BeginForm("DoiMatKhau", "KhachHang_65131134", FormMethod.Post, new { area = "Shop" }))
                    {
                        @Html.AntiForgeryToken()

                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 small shadow-sm mb-4 text-start">
                                <i class="fas fa-exclamation-circle me-2"></i> @Html.ValidationSummary(true, "")
                            </div>
                        }

                        <div class="text-start mb-4">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text"><i class="fas fa-lock-open"></i></span>
                                @Html.PasswordFor(m => m.MatKhauCu, new { @class = "form-control", placeholder = "••••••••", id = "pwd_old" })
                                <button class="btn btn-toggle-password" type="button" onclick="togglePwd('pwd_old', this)"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>

                        <div class="text-start mb-4">
                            <label class="form-label">Mật khẩu mới</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control", placeholder = "Ít nhất 6 ký tự", id = "pwd_new" })
                                <button class="btn btn-toggle-password" type="button" onclick="togglePwd('pwd_new', this)"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>

                        <div class="text-start mb-5">
                            <label class="form-label">Xác nhận mật khẩu mới</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                                @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", id = "pwd_confirm" })
                                <button class="btn btn-toggle-password" type="button" onclick="togglePwd('pwd_confirm', this)"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-submit w-100 shadow-sm mb-4">
                            <i class="fas fa-save me-2"></i> Cập nhật ngay
                        </button>

                        <a href="@Url.Action("ChinhSuaHoSo", "KhachHang_65131134")" class="text-muted small text-decoration-none hover-dark">
                            <i class="fas fa-chevron-left me-1"></i> Quay lại hồ sơ cá nhân
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function togglePwd(id, btn) {
        var x = document.getElementById(id);
        var icon = btn.querySelector('i');
        if (x.type === "password") {
            x.type = "text";
            icon.className = "fas fa-eye-slash";
        } else {
            x.type = "password";
            icon.className = "fas fa-eye";
        }
    }
</script>