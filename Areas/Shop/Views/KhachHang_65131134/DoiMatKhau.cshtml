@model Project_65131134.Models.DoiMatKhauViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<style>
    .card-custom {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        margin-top: 50px;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); /* Gradient tím xanh hiện đại */
        padding: 20px;
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
        border-color: #764ba2;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    .btn-toggle-password {
        cursor: pointer;
        z-index: 10;
    }
</style>

<div class="container py-5" style="">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-custom shadow-lg">
                <div class="card-header card-header-custom text-center text-white">
                    <h3 class="card-title mb-0 fw-bold"><i class="fas fa-key me-2"></i>Đổi Mật Khẩu</h3>
                    <small class="text-white-50">Bảo vệ tài khoản của bạn an toàn</small>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("DoiMatKhau", "KhachHang_65131134", FormMethod.Post, new { id = "changePasswordForm" }))
                    {
                        @Html.AntiForgeryToken()

                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <div class="mb-3">
                            @Html.LabelFor(m => m.MatKhauCu, new { @class = "form-label fw-bold text-secondary" })
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                                @Html.EditorFor(m => m.MatKhauCu, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập mật khẩu hiện tại", type = "password", id = "MatKhauCu" } })
                                <button class="btn btn-outline-secondary btn-toggle-password" type="button" onclick="togglePassword('MatKhauCu', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.MatKhauCu, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.MatKhauMoi, new { @class = "form-label fw-bold text-secondary" })
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-key text-muted"></i></span>
                                @Html.EditorFor(m => m.MatKhauMoi, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập mật khẩu mới", type = "password", id = "MatKhauMoi" } })
                                <button class="btn btn-outline-secondary btn-toggle-password" type="button" onclick="togglePassword('MatKhauMoi', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.MatKhauMoi, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.XacNhanMatKhau, new { @class = "form-label fw-bold text-secondary" })
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-check-circle text-muted"></i></span>
                                @Html.EditorFor(m => m.XacNhanMatKhau, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", type = "password", id = "XacNhanMatKhau" } })
                                <button class="btn btn-outline-secondary btn-toggle-password" type="button" onclick="togglePassword('XacNhanMatKhau', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-center">
                            <button type="submit" class="btn btn-primary px-4 fw-bold" style="background: #764ba2; border:none;">
                                <i class="fas fa-save me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword(fieldId, btn) {
        var input = document.getElementById(fieldId);
        var icon = btn.querySelector("i");

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }
</script>