@model Project_65131134.Models.ViewModels.CartViewModel
@using System.Globalization
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var fmt = new CultureInfo("vi-VN");
}

<section class="py-5 bg-light">
    <div class="container">
        <h3 class="fw-bold mb-4 text-uppercase">Giỏ hàng</h3>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="alert alert-info">Giỏ hàng của bạn đang trống.</div>
            <a class="btn btn-primary" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })">Tiếp tục mua sắm</a>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <div class="table-responsive shadow-sm bg-white rounded">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">Tên sản phẩm</th>
                                    <th class="text-center">Kích cỡ</th>
                                    <th class="text-end">Giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Tổng tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 me-3" style="width:70px;height:70px;overflow:hidden;border:1px solid #eee;border-radius:6px;">
                                                    <img src="@Url.Content("~/Images/DongHo/" + (item.SanPham.HinhAnh ?? "no-image.png"))" alt="@item.SanPham.TenDongHo" class="img-fluid" style="object-fit:contain;height:70px;width:70px;" />
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@item.SanPham.TenDongHo</div>
                                                    <small class="text-muted">Thương hiệu: @item.SanPham.ThuongHieu?.TenThuongHieu</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.SanPham.KichThuoc</td>
                                        <td class="text-end">@item.SanPham.GiaBan.ToString("N0", fmt) đ</td>
                                        <td class="text-center">@item.SoLuong</td>
                                        <td class="text-end fw-semibold">@item.ThanhTien.ToString("N0", fmt) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-4 mt-4 mt-lg-0">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Hóa đơn tạm tính</h5>
                            <ul class="list-unstyled mb-3">
                                @foreach (var item in Model.Items)
                                {
                                    <li class="d-flex justify-content-between mb-2">
                                        <span>@item.SanPham.TenDongHo</span>
                                        <span>@item.ThanhTien.ToString("N0", fmt) đ</span>
                                    </li>
                                }
                            </ul>
                            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                <span class="fw-bold">Tổng thanh toán:</span>
                                <span class="fw-bold text-danger fs-5">@Model.TongTien.ToString("N0", fmt) đ</span>
                            </div>
                            <div class="d-grid mt-3">
                                <a class="btn btn-warning fw-bold" href="@Url.Action("ThanhToan", "KhachHang_65131134", new { area = "Shop" })">Đặt hàng</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

