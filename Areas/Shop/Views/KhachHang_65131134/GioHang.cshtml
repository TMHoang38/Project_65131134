@model Project_65131134.Models.ViewModels.CartViewModel
@using System.Globalization
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var fmt = new CultureInfo("vi-VN");
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-uppercase mb-0">Giỏ hàng</h3>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })">
                <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
            </a>
        </div>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="alert alert-info shadow-sm py-4 text-center">
                <i class="bi bi-cart-x fs-1 d-block mb-3"></i>
                Giỏ hàng của bạn đang trống.
                <div class="mt-3">
                    <a class="btn btn-primary" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })">Mua sắm ngay</a>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <div class="table-responsive shadow-sm bg-white rounded">
                        <table class="table align-middle mb-0" id="cart-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">Tên sản phẩm</th>
                                    <th class="text-center">Kích cỡ</th>
                                    <th class="text-end">Giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Tổng tiền</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="row-@item.SanPham.MaDongHo">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 me-3" style="width:70px;height:70px;overflow:hidden;border:1px solid #eee;border-radius:6px;">
                                                    <img src="@Url.Content("~/Images/DongHo/" + (item.SanPham.HinhAnh ?? "no-image.png"))" alt="@item.SanPham.TenDongHo" class="img-fluid" style="object-fit:contain;height:70px;width:70px;" />
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@item.SanPham.TenDongHo</div>
                                                    <small class="text-muted">Thương hiệu: @item.SanPham.ThuongHieu.TenThuongHieu</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.SanPham.KichThuoc</td>
                                        <td class="text-end text-nowrap">@item.SanPham.GiaBan.ToString("N0", fmt)&nbsp;đ</td>
                                        <td class="text-center">
                                            <div class="quantity-control d-inline-flex align-items-center shadow-sm">
                                                <button class="btn-qty btn-minus" type="button" data-id="@item.SanPham.MaDongHo">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="number" class="qty-input quantity-input" value="@item.SoLuong" min="1" readonly data-id="@item.SanPham.MaDongHo">
                                                <button class="btn-qty btn-plus" type="button" data-id="@item.SanPham.MaDongHo">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="fw-semibold item-total text-end text-nowrap" data-id="@item.SanPham.MaDongHo">
                                            @item.ThanhTien.ToString("N0", fmt)&nbsp;đ
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-link text-danger btn-remove-item" data-id="@item.SanPham.MaDongHo" title="Xóa sản phẩm">
                                                <i class="bi bi-trash fs-1"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-4 mt-4 mt-lg-0">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3 border-bottom pb-2 text-black">Hóa đơn tạm tính</h5>
                            <div class="d-flex justify-content-between align-items-center pt-3">
                                <span class="fw-bold">Tổng thanh toán:</span>
                                <span id="grand-total" class="fw-bold text-danger fs-3 text-nowrap">@Model.TongTien.ToString("N0", fmt)&nbsp;đ</span>
                            </div>
                            <div class="d-grid mt-3">
                                <a class="btn btn-warning btn-lg fw-bold" href="@Url.Action("ThanhToan", "KhachHang_65131134", new { area = "Shop" })">Tiến hành đặt hàng</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .quantity-control {
        border: 1px solid #dee2e6;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        height: 32px;
    }

    .btn-qty {
        border: none;
        background: transparent;
        width: 35px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-qty:hover {
            background-color: #f8f9fa;
        }

    .qty-input {
        width: 40px;
        border: none;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        outline: none;
        pointer-events: none;
    }

    .btn-remove-item:hover {
        color: #dc3545 !important;
        transform: scale(1.1);
        transition: 0.2s;
    }

    /* Cố định không cho các ô chứa số tiền xuống dòng trên mọi thiết bị */
    .item-total, .text-nowrap {
        white-space: nowrap !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Cấu hình Toast (thông báo nhỏ tự ẩn)
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true
            });

            // Nút Tăng
            $(document).on('click', '.btn-plus', function () {
                var input = $(this).siblings('.quantity-input');
                var id = $(this).attr('data-id');
                var newVal = parseInt(input.val()) + 1;
                updateCart(id, newVal, input);
            });

            // Nút Giảm
            $(document).on('click', '.btn-minus', function () {
                var input = $(this).siblings('.quantity-input');
                var id = $(this).attr('data-id');
                var currentVal = parseInt(input.val());
                if (currentVal > 1) {
                    updateCart(id, currentVal - 1, input);
                }
            });

            // Nút Xóa sản phẩm với SweetAlert2
            $(document).on('click', '.btn-remove-item', function () {
                var id = $(this).data('id');
                var row = $('#row-' + id);

                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: "Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Xóa ngay',
                    cancelButtonText: 'Hủy bỏ',
                    reverseButtons: true // Đưa nút Hủy sang trái cho tự nhiên
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("XoaKhoiGioHang", "KhachHang_65131134", new { area = "Shop" })',
                            type: 'POST',
                            data: { id: id },
                            success: function (res) {
                                if (res.success) {
                                    row.fadeOut(400, function () {
                                        $(this).remove();
                                        if ($('#cart-table tbody tr').length === 0) {
                                            location.reload();
                                        }
                                    });
                                    $('#grand-total').html(res.grandTotal.replace(/ /g, '&nbsp;'));

                                    // Thông báo xóa thành công
                                    Toast.fire({
                                        icon: 'success',
                                        title: 'Đã xóa sản phẩm'
                                    });
                                }
                            }
                        });
                    }
                });
            });

            function updateCart(productId, newQuantity, inputElement) {
                $.ajax({
                    url: '@Url.Action("CapNhatSoLuong", "KhachHang_65131134", new { area = "Shop" })',
                    type: 'POST',
                    data: { id: productId, quantity: newQuantity },
                    success: function (res) {
                        if (res.success) {
                            inputElement.val(newQuantity);
                            $('.item-total[data-id="' + productId + '"]').html(res.itemTotal.replace(/ /g, '&nbsp;'));
                            $('#grand-total').html(res.grandTotal.replace(/ /g, '&nbsp;'));
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Không thể kết nối máy chủ', 'error');
                    }
                });
            }
        });
    </script>
}