@using Project_65131134.Helpers
<!DOCTYPE html>
<html lang="en-US" dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>ĐỒNG HỒ HẢI TRIỀU</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto+Condensed:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/assets/css/theme.css" />

    
</head>

<body>
    <main class="main" id="top">
        <nav class="navbar navbar-expand-lg navbar-light fixed-top navbar-watch-white">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })">
                    <img src="~/Images/logo.png" alt="Watch Store Logo" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })#store">Cửa hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })#collections">Bộ sưu tập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home_65131134", new { area = "Shop" })#contact">Liên hệ</a>
                        </li>
                    </ul>

                    <div class="btn-nav-group border-start ps-lg-4">
                        @if (!AuthenticationHelper.IsLoggedIn() || !AuthenticationHelper.IsKhachHang())
                        {
                            <a class="btn-luxury btn-login" href="@Url.Action("Index", "DangNhap_65131134", new { area = "TaiKhoan" })">Đăng nhập</a>
                            <a class="btn-luxury btn-register" href="@Url.Action("Index", "DangKy_65131134", new { area = "TaiKhoan" })">Đăng ký</a>
                        }
                        else
                        {
                            <div class="d-flex align-items-center">
                                <a href="@Url.Action("GioHang", "KhachHang_65131134", new { area = "Shop" })" class="cart-icon-wrapper" id="cartIconLink">
                                    <i class="bi bi-cart3" style="font-size: 1.4rem;"></i>
                                    <span id="cartBadge" style="display: none;">0</span>
                                </a>

                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle user-dropdown-toggle" href="#" id="userDrop" data-bs-toggle="dropdown">
                                        <i data-feather="user" style="width: 20px; color: var(--watch-gold);"></i>
                                        <span class="text-uppercase small fw-bold">@AuthenticationHelper.GetFullName()</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3" style="border-top: 3px solid var(--watch-gold) !important; border-radius: 0;">
                                        <li><a class="dropdown-item py-2" href="@Url.Action("ChinhSuaHoSo", "KhachHang_65131134", new { area = "Shop" })">Thông tin cá nhân</a></li>
                                        <li><a class="dropdown-item py-2" href="@Url.Action("DonHangCuaToi", "KhachHang_65131134", new { area = "Shop" })">Đơn hàng của tôi</a></li>
                                        <li><a class="dropdown-item py-2" href="@Url.Action("DoiMatKhau", "KhachHang_65131134", new { area = "Shop" })">Đổi mật khẩu</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("DangXuat", "DangNhap_65131134", new { area = "TaiKhoan" })">Đăng xuất</a></li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <div class="container-fluid p-0" style="margin-top: var(--nav-height);">
            @RenderBody()
        </div>

        <footer id="contact">
            <div class="container">
                <div class="row">
                    <div class="col-md-3">
                        <h4 class="footer-logo text-white fw-bold mb-4">ĐỒNG HỒ HẢI TRIỀU</h4>
                        <p class="text-muted ">Đồng Hồ Hải Triều cung cấp sản phẩm đồng hồ chính hãng chất lượng loại 1 và trải nghiệm mua sắm khác biệt.</p>
                    </div>
                    <div class="col-md-3 mb-4">
                        <h6 class="text-white fw-bold text-uppercase mb-4">HỆ THỐNG CỬA HÀNG</h6>
                        <ul class="list-unstyled">
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">TP. HỒ CHÍ MINH</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">HÀ NỘI</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">HẢI PHÒNG</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">ĐÀ NẴNG</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">NHA TRANG</a></li>
                            <li><a href="#" class="text-muted text-decoration-none lh-lg">VŨNG TÀU</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">CẦN THƠ</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 mb-4">
                        <h6 class="text-white fw-bold text-uppercase mb-4">THÔNG TIN</h6>
                        <ul class="list-unstyled">
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">Thông tin liên hệ</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">Liên hệ đối tác doanh nghiệp</a></li>
                            <li><a href="#" class="text-muted text-decoration-none lh-lg">Vận chuyển & Giao nhận</a></li>
                            <li><a href="#" class="text-muted text-decoration-none  lh-lg">Tra cứu đồng hồ bảo hành</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 mb-4">
                        <h6 class="text-white fw-bold text-uppercase mb-4">Về chúng tôi</h6>
                        <ul class="list-unstyled footer-cert-list">
                            <li>
                                <img src="~/Images/chungnhan.png" alt="Chứng nhận chính hãng" />
                            </li>
                            <li>
                                <img src="~/Images/baohanh.png" alt="Bảo hành quốc tế" />
                            </li>
                            <li>
                                <img src="~/Images/hinh-anh-bo-cong-thuong.png" alt="Đã thông báo Bộ Công Thương" />
                            </li>
                        </ul>
                    </div>
                </div>
                <hr class="border-secondary my-2">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="text-muted small mb-0">&copy; 2025 Luxury Watch Store. Team 65131134.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <a href="#" class="text-white mx-2"><i data-feather="facebook"></i></a>
                        <a href="#" class="text-white mx-2"><i data-feather="instagram"></i></a>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/vendor/feather-icons/feather.min.js"></script>

    <script>
        $(document).ready(function () {
            // Khởi tạo Feather Icons
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            // Hàm cập nhật số lượng giỏ hàng
            function updateCartCount() {
                @if (AuthenticationHelper.IsLoggedIn() && AuthenticationHelper.IsKhachHang())
                {
                    <text>
                    $.ajax({
                        url: '@Url.Action("GetCartCount", "Home_65131134", new { area = "Shop" })',
                        type: 'GET',
                        success: function (data) {
                            var cartBadge = $('#cartBadge');
                            if (data.cartCount > 0) {
                                cartBadge.text(data.cartCount).fadeIn();
                            } else {
                                cartBadge.hide();
                            }
                        },
                        error: function () {
                            console.log('Error loading cart count');
                        }
                    });
                    </text>
                }
            }

            updateCartCount();
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
<style>
    :root {
        --watch-gold: #c5a059;
        --watch-dark: #1a1a1a;
        --nav-white: #ffffff;
        --nav-height: 85px;
    }

    body {
        font-family: 'Roboto Condensed', sans-serif;
        background-color: #f8f9fa;
        margin: 0;
        padding: 0;
    }

    /* --- NAVBAR CORE --- */
    .navbar-watch-white {
        background-color: var(--nav-white) !important;
        border-bottom: 1px solid #ececec;
        box-shadow: 0 2px 15px rgba(0,0,0,0.04);
        min-height: var(--nav-height);
        display: flex;
        align-items: center;
        padding: 0;
    }

    .navbar-brand img {
        height: 55px; /* Chiều cao logo cố định để không lệch hàng */
        width: auto;
        transition: transform 0.3s ease;
    }

    /* --- NAVIGATION LINKS --- */
    .navbar-nav .nav-link {
        color: var(--watch-dark) !important;
        font-weight: 700 !important;
        font-size: 0.9rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 10px 20px !important;
        transition: all 0.3s ease;
        position: relative;
    }

        .navbar-nav .nav-link:hover {
            color: var(--watch-gold) !important;
        }

    /* --- BUTTONS (Luxury Style) --- */
    .btn-nav-group {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-left: 20px;
    }

    .btn-luxury {
        padding: 10px 28px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 0; /* Vuông vức theo mẫu Hải Triều */
        letter-spacing: 1px;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        text-decoration: none;
    }

    .btn-login {
        border: 1px solid var(--watch-gold);
        color: var(--watch-gold) !important;
        background: transparent;
    }

        .btn-login:hover {
            background: #fcf9f2;
            color: var(--watch-gold) !important;
        }

    .btn-register {
        background-color: var(--watch-gold);
        color: white !important;
        border: 1px solid var(--watch-gold);
    }

        .btn-register:hover {
            filter: brightness(1.1);
            box-shadow: 0 4px 12px rgba(197, 160, 89, 0.2);
        }

    .footer-cert-list li {
        margin-bottom: 15px; /* Khoảng cách giữa các ảnh */
    }

    .footer-cert-list img {
        max-width: 220px; /* Giới hạn chiều rộng tối đa */
        height: auto; /* Tự động tính chiều cao để không bị méo ảnh */
        display: block;
        transition: 0.3s ease;
        filter: brightness(0.9); /* Làm ảnh hơi tối lại cho tiệp màu nền */
    }

        .footer-cert-list img:hover {
            filter: brightness(1); /* Sáng lên khi di chuột vào */
        }

        /* Riêng logo Bộ Công Thương thường cần nhỏ hơn nữa */
        .footer-cert-list img[src*="bo-cong-thuong"] {
            max-width: 120px;
        }

    /* --- ICONS & USER --- */
    .cart-icon-wrapper {
        position: relative;
        margin-right: 15px;
        color: var(--watch-dark);
        transition: 0.3s;
    }

        .cart-icon-wrapper:hover {
            color: var(--watch-gold);
        }

    #cartBadge {
        position: absolute;
        top: -5px;
        right: -8px;
        background-color: #d9534f;
        color: white;
        font-size: 0.65rem;
        padding: 2px 5px;
        border-radius: 50%;
        min-width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-dropdown-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    /* --- FOOTER --- */
    footer {
        background-color: var(--watch-dark);
        color: #fff;
        padding: 60px 0 30px;
        margin-top: 50px;
    }

    .footer-logo {
        font-family: 'Playfair Display', serif;
        letter-spacing: 2px;
    }
</style>
</html>
